{
  "name": "nodejs-tutorials",
  "version": "0.1.0",
  "description": "Modular, hands-on Node.js + TypeScript tutorials for backend development.",
  "private": true,
  "type": "module",
  "workspaces": [
    "basics",
    "core-api",
    "async",
    "oop",
    "web",
    "database",
    "auth",
    "testing",
    "architecture/monolith",
    "architecture/modular-monolith",
    "architecture/distributed",
    "architecture/microservice",
    "docker",
    "ai/mastra/mastra-basics",
    "ai/mastra/mastra-tools",
    "ai/mastra/mastra-memory",
    "ai/mastra/mastra-rag",
    "ai/mastra/mastra-workflows",
    "ai/mastra/mastra-mcp",
    "ai/mastra/mastra-evals",
    "ai/mastra/mastra-patterns",
    "ai/mastra/mastra-capstone"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
