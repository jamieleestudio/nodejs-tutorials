{
  "name": "@mmm/bootstrap",
  "version": "0.2.0",
  "description": "Monolithic multi-module — bootstrap: assembles @mmm/order + @mmm/user into ONE deployable process (like mmm-bootstrap fat jar).",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=../../.env src/main.ts",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mmm/order": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2"
  }
}
