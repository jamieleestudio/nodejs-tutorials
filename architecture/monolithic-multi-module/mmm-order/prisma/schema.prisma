// Prisma schema for @mmm/order — Order bounded context owns its own database
// Run: pnpm --filter @mmm/order prisma:migrate

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_MMM_ORDER")
}

model Order {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
