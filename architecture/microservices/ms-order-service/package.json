{
  "name": "@ms/order-service",
  "version": "0.2.0",
  "description": "Microservices — Order service: HTTP REST + TCP ClientProxy RPC to User service, own database arch_ms_order.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts"
  },
  "scripts": {
    "start": "tsx --env-file=../../.env src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev --name init"
  },
  "dependencies": {
    "@ms/shared-kernel": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/client": "5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6.0"
  }
}
