{
  "name": "@dist/master",
  "version": "0.2.0",
  "description": "Distributed architecture — master process: HTTP /tasks/compute, shards tasks and dispatches to workers. Forks @dist/worker child processes.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=../../.env src/main.ts",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dist/task-core": "workspace:*",
    "@dist/worker": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
