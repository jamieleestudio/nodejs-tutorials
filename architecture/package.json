{
  "name": "nodejs-tutorials-architecture",
  "version": "0.1.0",
  "description": "NestJS + DDD + Clean Architecture learning projects.",
  "private": true,
  "workspaces": [
    "monolith",
    "modular-monolith",
    "distributed",
    "microservice"
  ],
  "scripts": {
    "start:monolith": "npm start -w monolith",
    "start:modular-monolith": "npm start -w modular-monolith",
    "start:distributed": "npm start -w distributed",
    "start:microservice": "npm start -w microservice",
    "typecheck": "npm run typecheck --workspaces",
    "prisma:generate": "npm run prisma:generate --workspaces",
    "prisma:migrate": "npm run prisma:migrate --workspaces"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/cqrs": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "class-validator": "^0.15.1",
    "class-transformer": "^0.5.1",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "prisma": "^5.22.0",
    "@types/node": "^22.0.0"
  }
}