{
  "name": "nodejs-tutorials-architecture",
  "version": "0.2.0",
  "description": "Architecture patterns with NestJS + DDD + Clean Architecture — pnpm + Turborepo workspace (7 patterns, mirroring java-tutorials/architecture).",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "start:monolithic": "turbo run start --filter=@arch/monolithic",
    "start:mmm": "turbo run start --filter=@mmm/bootstrap",
    "start:dist": "turbo run start --filter=@dist/master",
    "start:ms": "turbo run start --filter=@ms/demo",
    "start:eda": "turbo run start --filter=@eda/demo",
    "start:erp": "turbo run start --filter=@erp/app",
    "prisma:generate": "turbo run prisma:generate",
    "docker:up": "docker compose up -d"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.0",
    "turbo": "^2.4.0",
    "typescript": "^5.6.0"
  }
}
