{
  "name": "@arch/monolithic",
  "version": "0.2.0",
  "description": "Monolithic architecture: non-CQRS + User domain + Clean Architecture. Single module, single deployable.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=../../.env src/main.ts",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev --name init"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "class-validator": "^0.15.1",
    "class-transformer": "^0.5.1"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  }
}
